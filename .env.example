# 复制为 .env 并填入真实值：copy .env.example .env
# 注意：.env 已在 .gitignore 中，不要提交真实密钥

# ---- 对话模型（provider 固定为 openai，走 OpenAI 兼容协议）----
# BYOK 模式下这只是「默认/兜底」配置：生产路径中用户的 key 经请求体 ChatRequest.llm
# 按请求传入（前端把 key 保存在浏览器侧，服务端不持久化用户 key），此处供示例脚本与自测使用。
# 换厂商只改这三项（如百炼 qwen-plus、智谱 glm-4-plus）
OPENAI_API_KEY=sk-xxxxxxxx
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# ---- 向量化（长期记忆的语义检索用，同样是 OpenAI 兼容接口）----
# DeepSeek 不提供 embedding 接口，必须单独指定。两种方式二选一：
# ① 本地（推荐，离线可用、零配额）：Docker 起 TEI 容器
#    模型文件先用 huggingface_hub 下载到 data/models/bge-m3（TEI 自带下载器与镜像站不兼容），然后：
#    docker run -d --name oj-embed -p 8080:80 -v <项目路径>/data/models:/data `
#      ghcr.io/huggingface/text-embeddings-inference:cpu-1.8.3 --model-id /data/bge-m3 `
#      --max-batch-tokens 4096 --max-concurrent-requests 32 --auto-truncate
#    EMBEDDING_MODEL=bge-m3
#    EMBEDDING_BASE_URL=http://localhost:8080/v1/embeddings
#    EMBEDDING_API_KEY=local          # 任意非空值即可
# ② 云端百炼 DashScope：
#    EMBEDDING_MODEL=text-embedding-v3
#    EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/embeddings
#    EMBEDDING_API_KEY=sk-xxxxxxxx
# 注意：EMBEDDING_BASE_URL 必须是「完整 endpoint」，openjiuwen 会直接 POST
#       该地址而不会再拼 /embeddings。
# ⚠ 切换 embedding 提供方后必须清空 data/chroma 与 SQLite 旧记忆（向量空间不兼容），
#   否则语义检索会静默返回错误结果。
EMBEDDING_MODEL=bge-m3
EMBEDDING_BASE_URL=http://localhost:8080/v1/embeddings
EMBEDDING_API_KEY=local

# ---- Neo4j 图谱 ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# auto（连不上 Neo4j 自动降级到样例数据）/ neo4j / sample
GRAPH_BACKEND=auto
# 留空则用项目下 data/sample_graph.csv
SAMPLE_GRAPH=

# ---- 本地存储（会话归档 / 向量库 / 技能手册 / 题库）----
SQLITE_PATH=
CHROMA_DIR=
# 技能目录：SKILL.md 在此按 <name>/SKILL.md 组织，通过 read_file 按需加载
SKILLS_DIR=
# 题库 RAG 的 Chroma 集合名（全局共享，与用户记忆集合物理隔离）
QUESTION_COLLECTION=question_bank

# ---- 长期记忆 ----
# 记忆按 user_id + scope_id 隔离，scope_id 全项目固定
MEMORY_SCOPE_ID=medical-kg-course
MEMORY_ENABLE_PROFILE=true
MEMORY_ENABLE_SEMANTIC=true
MEMORY_ENABLE_EPISODIC=true
MEMORY_ENABLE_SUMMARY=true
# 记忆检索超时上限（秒）：检索是每轮回答的固定前置成本，嵌入接口变慢时
# 宁可本轮不带长期记忆，也不让用户干等（超时后降级为空，不报错）。
MEMORY_RETRIEVE_TIMEOUT_SECONDS=5

# ---- 行为参数 ----
# ReAct 迭代上限（= 模型轮数，每轮一次完整 LLM 往返）。
# 性能优化后实测：闲聊 1 轮、语境追问 2 轮、复杂用药 4 轮、单实体问答最多 7 轮
# （搜实体 → 看关系分布 → 按类型取数 → 查禁忌 → 生成答案）。
# 设 5 仍会在"单实体 + 多类型关系"场景于生成答案前耗尽预算：SDK 返回字符串
# "Max iterations reached without completion"（不抛异常，证据实体全部作废），故默认保持 8。
# 想更快出答案靠减少模型绕弯（提示词预算 + 工具层同轮去重/上限），不能靠砍这个值。
MAX_ITERATIONS=8
CONTEXT_WINDOW_ROUNDS=10
# 全项目共享的 LLM 限流上限（每分钟请求数）。正常使用不加任何延迟，
# 只有最近 60 秒内的请求数达到该值时才等待；设为 0 即完全关闭节流。
LLM_RPM_LIMIT=100

# ---- 上传文件 ----
# 落盘目录（默认 data/uploads，按 <user_id>/<file_id>/ 组织，删除文件时整目录清掉）
UPLOAD_DIR=
# 单文件大小上限（MB）
UPLOAD_MAX_MB=20
# 单条消息最多携带文件数（同时是单次上传接口的个数上限）
UPLOAD_MAX_FILES=3
# 注入对话时每份文件正文的字数上限（超出截断并标注“已截断”）
UPLOAD_CHAR_LIMIT=6000
# 图片文件靠视觉模型生成文字描述（caption）：用户 BYOK 配置为视觉模型时优先用用户的，
# 否则用上方 OPENAI_* 默认模型；默认模型不支持视觉时上传图片会得到明确报错

# ---- 后端路由层（server/，接口契约见 接口文档.md）----
# 启动：.\.venv\Scripts\python.exe -m server.main
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
# JWT 签名密钥（生产必须显式配置为足够长的随机串，如 openssl rand -hex 32）。
# 留空则每次启动随机生成：服务重启后所有已签发令牌失效，仅限本地调试。
JWT_SECRET=
# 令牌有效期（分钟），默认 720 = 12 小时
JWT_EXPIRE_MINUTES=720
# 是否开放注册（false 时仅已有账号可登录，新账号需手工入库）
ALLOW_REGISTRATION=true
# 用户库位置（后端自有，与 Agent 层 data/app.db 分离）
USER_DB_PATH=data/server.db
# 允许跨域的前端来源（逗号分隔）；留空 = 允许所有来源（BYOK 无 cookie，无凭证风险）。
# 生产建议显式配置为前端域名，如 CORS_ORIGINS=https://med.example.com
CORS_ORIGINS=
